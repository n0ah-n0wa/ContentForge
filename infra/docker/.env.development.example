# Optional overrides for docker compose (local development).
# Copy to .env.development in the repository root, or pass with:
#   docker compose --env-file .env.development up -d --build
#
# Defaults work out of the box — this file documents available settings.

# PostgreSQL
POSTGRES_USER=contentforge
POSTGRES_PASSWORD=contentforge
POSTGRES_DB=contentforge
POSTGRES_PORT=5432

# Host ports
WEB_PORT=8080
API_PORT=5080

# JWT (Development placeholder — never use in production)
JWT_SIGNING_KEY=DEV_ONLY_CHANGE_ME_32_CHARS_MINIMUM_KEY

# Media: Local (default) or Azure (Azurite emulator)
MEDIA_PROVIDER=Local

# To exercise Azure Blob against Azurite instead of local disk, set:
# MEDIA_PROVIDER=Azure
# Media__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Azurite host ports (when running API on host against compose Azurite, use localhost:10000)
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# Leave empty for same-origin /api proxy through nginx
VITE_API_BASE_URL=
