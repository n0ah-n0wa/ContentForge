server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Docker embedded DNS — defer upstream resolution until request time
    resolver 127.0.0.11 valid=30s ipv6=off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Container health probe (does not depend on backend availability)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API health probes via proxy (minimal JSON; verifies DB and blob readiness externally)
    location = /health/live {
        set $api_upstream ${API_UPSTREAM};
        set $api_scheme ${API_UPSTREAM_SCHEME};
        set $api_host ${API_UPSTREAM_HOST};
        proxy_pass $api_scheme://$api_upstream/health/live;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $api_host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        access_log off;
    }

    location = /health/ready {
        set $api_upstream ${API_UPSTREAM};
        set $api_scheme ${API_UPSTREAM_SCHEME};
        set $api_host ${API_UPSTREAM_HOST};
        proxy_pass $api_scheme://$api_upstream/health/ready;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $api_host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        access_log off;
    }

    # API reverse proxy — scheme/host/port supplied at runtime
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        set $api_scheme ${API_UPSTREAM_SCHEME};
        set $api_host ${API_UPSTREAM_HOST};
        proxy_pass $api_scheme://$api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $api_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    # Local media files served by the API when Media:Provider=Local
    location /media-files/ {
        set $api_upstream ${API_UPSTREAM};
        set $api_scheme ${API_UPSTREAM_SCHEME};
        set $api_host ${API_UPSTREAM_HOST};
        proxy_pass $api_scheme://$api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $api_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Vue SPA — client-side routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
