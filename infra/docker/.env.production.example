# Copy to repository root as .env.production (gitignored) before running docker-compose.prod.yml.
# Never commit real secrets.
#
# BEFORE `docker compose -f docker-compose.prod.yml --env-file .env.production up -d`:
#   1. Set POSTGRES_PASSWORD to a non-empty value (required by compose).
#   2. Set JWT_SIGNING_KEY to >= 32 characters without DEV_ONLY / TEST_ONLY / CHANGE_ME / REPLACE_ME.
#   3. Run the migrate profile once before first API use (Production does not auto-migrate).

# PostgreSQL (used by the local production stack only; use Azure SQL in real cloud deployments)
POSTGRES_USER=contentforge
POSTGRES_PASSWORD=
POSTGRES_DB=contentforge

# JWT — minimum 32 characters; must not contain DEV_ONLY, TEST_ONLY, CHANGE_ME, or REPLACE_ME
JWT_SIGNING_KEY=
JWT_ISSUER=ContentForge
JWT_AUDIENCE=ContentForge.Admin

# Public admin UI origin (CORS) and host port mapping
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_PORT=8080

# Optional image tags for CI/CD pipelines
CONTENTFORGE_API_IMAGE=contentforge-api:local
CONTENTFORGE_WEB_IMAGE=contentforge-web:local

# Media backend inside the API container: Local or Azure
MEDIA_PROVIDER=Local

# Leave empty to serve the SPA and API on the same origin via nginx (/api proxy)
VITE_API_BASE_URL=

# Password reset (required in Production — local prod compose uses MailHog)
# PasswordReset__DeliveryMode=Smtp
# PasswordReset__PublicAppBaseUrl=http://localhost:8080
# PasswordReset__Smtp__Host=mailhog
# PasswordReset__Smtp__Port=1025
# PasswordReset__Smtp__EnableSsl=false
# PasswordReset__Smtp__FromAddress=noreply@contentforge.local
