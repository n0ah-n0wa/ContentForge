<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ContentForge.Api</RootNamespace>
    <AssemblyName>ContentForge.Api</AssemblyName>
    <Description>ContentForge HTTP API — controllers, middleware, and composition root.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContentForge.Application\ContentForge.Application.csproj" />
    <ProjectReference Include="..\ContentForge.Infrastructure\ContentForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
