{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=contentforge;Username=contentforge;Password=contentforge"
  },
  "Jwt": {
    "Issuer": "ContentForge",
    "Audience": "ContentForge.Admin",
    "SigningKey": "DEV_ONLY_CHANGE_ME_32_CHARS_MINIMUM_KEY",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },
  "Media": {
    "Provider": "Local",
    "LocalRoot": "App_Data/media",
    "PublicBaseUrl": "/media-files",
    "ContainerName": "media",
    "UseManagedIdentity": false
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": "",
    "SamplingRatio": 1.0
  }
}
