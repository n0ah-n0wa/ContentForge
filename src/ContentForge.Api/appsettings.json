{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "ContentForge",
    "Audience": "ContentForge.Admin",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Media": {
    "Provider": "Local",
    "LocalRoot": "App_Data/media",
    "PublicBaseUrl": "/media-files",
    "ContainerName": "media",
    "UseManagedIdentity": false
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": "",
    "SamplingRatio": 1.0
  },
  "ContentPreview": {
    "TokenLifetimeMinutes": 15
  },
  "PublicContentCache": {
    "Enabled": true,
    "EntryTtlSeconds": 300,
    "ListTtlSeconds": 60,
    "MaxEntries": 1024
  },
  "RateLimiting": {
    "Enabled": true,
    "DisabledPermitLimit": 100000,
    "AuthLogin": {
      "PermitLimit": 15,
      "WindowSeconds": 60
    },
    "AuthRefresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "PasswordResetRequest": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "PasswordResetConfirm": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicApi": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "MediaUpload": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "PartitionByAuthenticatedUser": true
    },
    "ContentPreview": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
