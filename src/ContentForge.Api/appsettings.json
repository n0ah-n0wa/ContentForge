{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "ContentForge",
    "Audience": "ContentForge.Admin",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Media": {
    "Provider": "Local",
    "LocalRoot": "App_Data/media",
    "PublicBaseUrl": "/media-files",
    "ContainerName": "media",
    "UseManagedIdentity": false
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": "",
    "SamplingRatio": 1.0
  },
  "ContentPreview": {
    "TokenLifetimeMinutes": 15
  },
  "PublicContentCache": {
    "Enabled": true,
    "EntryTtlSeconds": 300,
    "ListTtlSeconds": 60,
    "MaxEntries": 1024
  }
}
